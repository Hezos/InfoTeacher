{
  "name": "advertise",
  "version": "1.0.10",
  "description": "This is a JavaScript library to help quickly generate ads",
  "author": "liaoqinwei",
  "license": "MIT",
  "main": "lib/index.js",
  "files": [
    "lib/"
  ],
  "types": "lib/index.d.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "cross-env NODE_ENV=development webpack-dev-server --config webpack.config.js",
    "build:webp": "cross-env NODE_ENV=production webpack --config webpack.config.js",
    "build:pub": "tsc -p ./ && cleancss -o lib/advertise.min.css src/common/animation.css src/common/common.css src/common/swiper.min.css",
    "publish": "npm publish --registry=http://registry.npmjs.org",
    "publish:beta": "npm publish --registry=http://registry.npmjs.org --tag-beta"
  },
  "keywords": [
    "advertise",
    "广告",
    "web advertise",
    "mobile"
  ],
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@babel/plugin-proposal-class-properties": "^7.12.1",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.12.7",
    "@babel/preset-typescript": "^7.12.7",
    "babel-loader": "^8.0.0-beta.0",
    "cross-env": "^7.0.3",
    "css-loader": "^5.0.1",
    "html-webpack-plugin": "^4.5.0",
    "style-loader": "^2.0.0",
    "ts-loader": "^8.0.11",
    "typescript": "^4.1.2",
    "webpack": "^5.9.0",
    "webpack-cli": "^3.3.12",
    "webpack-dev-server": "^3.11.0",
    "webpack-merge": "^5.4.0"
  },
  "dependencies": {
    "swiper": "^6.4.5",
    "uuid": "^8.3.1"
  }
}
